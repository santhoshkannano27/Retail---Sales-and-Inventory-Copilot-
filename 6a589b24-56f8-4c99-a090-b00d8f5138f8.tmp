            <div class="font-semibold text-white">$${po.totalCost.toLocaleString()}</div>
            <span class="text-[10px] px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-medium">${po.status} &bull; ${po.eta}</span>
          </div>
