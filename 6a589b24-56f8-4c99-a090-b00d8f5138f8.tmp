    const DEFAULT_SALES_STREAM = [
      { time: "2m ago", item: "CloudStride Pro Running Shoes", qty: 1, amount: "$140.00", channel: "In-Store #104" },
      { time: "8m ago", item: "SonicShield Wireless Earbuds ANC", qty: 2, amount: "$259.98", channel: "Online Web" },
      { time: "14m ago", item: "Merino Wool Thermal Crew", qty: 1, amount: "$85.00", channel: "In-Store #104" },
      { time: "22m ago", item: "Everyday Minimalist Canvas Backpack", qty: 1, amount: "$79.00", channel: "Mobile App" },
      { time: "31m ago", item: "High-Compression Running Socks", qty: 3, amount: "$84.00", channel: "In-Store #104" }
    ];

    // Historical 7D sales + 7D forecast data
    const SALES_CHART_DATA = {
      labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun", "Next Mon", "Next Tue", "Next Wed", "Next Thu", "Next Fri", "Next Sat", "Next Sun"],
      actual: [5200, 5800, 6100, 5950, 7400, 9600, 8870, null, null, null, null, null, null, null],
      forecast: [null, null, null, null, null, null, 8870, 6200, 6700, 7100, 7400, 8900, 11400, 10200]
    };

    /* ================= APP STATE ================= */
    let appState = {
      inventory: JSON.parse(localStorage.getItem("retail_inventory")) || DEFAULT_INVENTORY,
      purchaseOrders: JSON.parse(localStorage.getItem("retail_pos")) || DEFAULT_PURCHASE_ORDERS,
      salesStream: JSON.parse(localStorage.getItem("retail_sales_stream")) || DEFAULT_SALES_STREAM,
      filters: {
        search: "",
        category: "All",
        status: "All",
        store: "downtown",
        dateRange: "7d"
      },
      chatHistory: [
        {
          role: "assistant",
          timestamp: "Just now",
          text: "Hello! I am your **Retail Sales and Inventory Copilot**.",
          dataCards: [
            {
              type: "alert",
              title: "⚡ 3 SKUs Require Immediate Restock",
              content: "CloudStride Shoes, Merino Thermal Crew, and SonicShield Earbuds are burning fast and will stock out within 2.4 - 3.7 days.",
              action: "Draft Restock PO",
              prompt: "Draft restock purchase order for critical items"
            }
          ]
        }
      ],
      activeDraftPO: null
    };

    /* ================= COMPUTED METRICS ================= */
    function computeMetrics(item) {
      const daysOfSupply = item.dailyVelocity > 0 ? (item.stock / item.dailyVelocity) : 999;
      let status = "Optimal";

      if (item.stock === 0 || daysOfSupply <= item.leadTimeDays) {
        status = "Critical";
      } else if (item.stock <= item.reorderPoint || daysOfSupply < 10) {
        status = "Reorder";
      } else if (daysOfSupply > 45 && item.dailyVelocity < 1.0) {
        status = "Overstock";
      }

      return {
        daysOfSupply: daysOfSupply.toFixed(1),
        status: status,
        stockoutRiskCost: (status === "Critical" || status === "Reorder") ? Math.round(item.dailyVelocity * item.price * 7) : 0
      };
    }

    function calculateOverallKPIs() {
      let criticalCount = 0;
      let reorderCount = 0;
      let optimalCount = 0;
      let overstockCount = 0;
      let totalRiskCost = 0;
      let totalDOS = 0;

      appState.inventory.forEach(item => {
        const m = computeMetrics(item);
        if (m.status === "Critical") criticalCount++;
        else if (m.status === "Reorder") reorderCount++;
        else if (m.status === "Optimal") optimalCount++;
        else if (m.status === "Overstock") overstockCount++;

        totalRiskCost += m.stockoutRiskCost;
        totalDOS += parseFloat(m.daysOfSupply);
      });

      const totalItems = appState.inventory.length;
      const avgDOS = totalItems > 0 ? (totalDOS / totalItems).toFixed(1) : 0;
      const healthScore = Math.max(20, Math.min(100, Math.round(100 - (criticalCount * 12) - (reorderCount * 4) - (overstockCount * 3))));

      return {
        criticalCount,
        reorderCount,
        optimalCount,
        overstockCount,
        totalItems,
        totalRiskCost,
        avgDOS,
        healthScore
      };
    }

    /* ================= RENDER DOM FUNCTIONS ================= */
    function renderKPIs() {
      const kpis = calculateOverallKPIs();

      document.getElementById("kpiHealthScore").innerHTML = `${kpis.healthScore}<span class="text-base font-normal text-slate-400">/100</span>`;
      document.getElementById("kpiRiskCost").textContent = `$${kpis.totalRiskCost.toLocaleString()}`;
      document.getElementById("kpiDOS").innerHTML = `${kpis.avgDOS} <span class="text-base font-normal text-slate-400">days</span>`;
      document.getElementById("kpiCriticalCountText").textContent = `${kpis.criticalCount} SKUs below safety buffer`;

      // Status counters
      document.getElementById("countAll").textContent = kpis.totalItems;
      document.getElementById("countCritical").textContent = kpis.criticalCount;
      document.getElementById("countReorder").textContent = kpis.reorderCount;
      document.getElementById("countOptimal").textContent = kpis.optimalCount;
      document.getElementById("countOverstock").textContent = kpis.overstockCount;
      document.getElementById("inventoryCountBadge").textContent = `${kpis.totalItems} SKUs`;

      // Update segmented bar
      if (kpis.totalItems > 0) {
        document.getElementById("barOptimal").style.width = `${(kpis.optimalCount / kpis.totalItems) * 100}%`;
        document.getElementById("barLow").style.width = `${(kpis.reorderCount / kpis.totalItems) * 100}%`;
        document.getElementById("barCritical").style.width = `${(kpis.criticalCount / kpis.totalItems) * 100}%`;
        document.getElementById("barOverstock").style.width = `${(kpis.overstockCount / kpis.totalItems) * 100}%`;
      }
    }

    function renderInventoryTable() {
      const tbody = document.getElementById("inventoryTableBody");
      tbody.innerHTML = "";

      const filtered = appState.inventory.filter(item => {
        const m = computeMetrics(item);
        const matchSearch = item.name.toLowerCase().includes(appState.filters.search.toLowerCase()) ||
                            item.sku.toLowerCase().includes(appState.filters.search.toLowerCase()) ||
                            item.supplier.toLowerCase().includes(appState.filters.search.toLowerCase());
        const matchCat = appState.filters.category === "All" || item.category === appState.filters.category;
        const matchStatus = appState.filters.status === "All" || m.status === appState.filters.status;

        return matchSearch && matchCat && matchStatus;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="text-center py-8 text-slate-500 text-xs">
              No inventory records found matching current criteria.
            </td>
          </tr>
        `;
        return;
      }

      filtered.forEach(item => {
        const m = computeMetrics(item);

        let badgeHtml = "";
        if (m.status === "Critical") {
          badgeHtml = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/20 text-rose-300 border border-rose-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-ping"></span> Critical Stockout
          </span>`;
        } else if (m.status === "Reorder") {
          badgeHtml = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
            ⚠️ Reorder Needed
          </span>`;
        } else if (m.status === "Overstock") {
          badgeHtml = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
            📦 Stagnant (${m.daysOfSupply}d)
          </span>`;
        } else {
          badgeHtml = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            ✅ Optimal
          </span>`;
        }

        const tr = document.createElement("tr");
        tr.className = "hover:bg-slate-800/40 transition group";
        tr.innerHTML = `
          <td class="py-3 px-3">
            <div class="flex items-center gap-2.5">
              <span class="text-xl p-1 bg-slate-800 rounded-lg">${item.image || "📦"}</span>
              <div>
                <div class="font-medium text-white group-hover:text-indigo-300 transition">${item.name}</div>
                <div class="text-[11px] text-slate-500">${item.sku} &bull; <span class="text-slate-400">${item.supplier}</span></div>
              </div>
            </div>
          </td>
          <td class="py-3 px-3">
            <span class="text-slate-300">${item.category}</span>
          </td>
          <td class="py-3 px-3 font-semibold ${item.stock < item.reorderPoint ? 'text-rose-400' : 'text-slate-200'}">
            ${item.stock} units
          </td>
          <td class="py-3 px-3 text-slate-400">
            ${item.reorderPoint} units
          </td>
          <td class="py-3 px-3 text-slate-300">
            ${item.dailyVelocity} /day
          </td>
          <td class="py-3 px-3 font-mono font-medium ${parseFloat(m.daysOfSupply) <= 4 ? 'text-rose-400' : 'text-slate-300'}">
            ${m.daysOfSupply} d
          </td>
          <td class="py-3 px-3">
            ${badgeHtml}
          </td>
          <td class="py-3 px-3 text-right">
            <div class="flex items-center justify-end gap-1.5">
              ${m.status === "Critical" || m.status === "Reorder" ? `
                <button onclick="triggerRestockSingle('${item.sku}')" class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-[11px] font-medium transition shadow-sm" title="Draft restock order">
                  Restock
                </button>
              ` : ''}
              ${m.status === "Overstock" ? `
                <button onclick="triggerMarkdownPrompt('${item.sku}')" class="px-2.5 py-1 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 rounded text-[11px] font-medium transition" title="Copilot markdown advisor">
                  Markdown
                </button>
              ` : ''}
              <button onclick="openStockAdjustModal('${item.sku}')" class="p-1 text-slate-400 hover:text-white rounded hover:bg-slate-800" title="Adjust stock manually">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

