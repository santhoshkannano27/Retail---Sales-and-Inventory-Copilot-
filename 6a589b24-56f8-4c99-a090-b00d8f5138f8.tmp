    /* ================= CHARTS ENGINE (CANVAS NATIVE) ================= */
    function drawSalesForecastChart() {
      const canvas = document.getElementById("salesForecastChart");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");

      // Retina display handling
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);

      const width = rect.width;
      const height = rect.height;
      const padding = { top: 20, right: 25, bottom: 35, left: 50 };

      ctx.clearRect(0, 0, width, height);

      const labels = SALES_CHART_DATA.labels;
      const actual = SALES_CHART_DATA.actual;
      const forecast = SALES_CHART_DATA.forecast;

      const maxValue = 13000;
      const minValue = 3000;

      const chartW = width - padding.left - padding.right;
      const chartH = height - padding.top - padding.bottom;

      function getX(index) {
        return padding.left + (index / (labels.length - 1)) * chartW;
      }
      function getY(val) {
        return padding.top + chartH - ((val - minValue) / (maxValue - minValue)) * chartH;
      }

      // Draw Grid lines
      ctx.strokeStyle = "rgba(148, 163, 184, 0.1)";
      ctx.lineWidth = 1;
      const gridSteps = 4;
      for (let i = 0; i <= gridSteps; i++) {
        const val = minValue + (i / gridSteps) * (maxValue - minValue);
        const y = getY(val);
        ctx.beginPath();
        ctx.moveTo(padding.left, y);
        ctx.lineTo(width - padding.right, y);
        ctx.stroke();

        ctx.fillStyle = "rgba(148, 163, 184, 0.5)";
        ctx.font = "10px sans-serif";
        ctx.textAlign = "right";
        ctx.fillText(`$${(val / 1000).toFixed(0)}k`, padding.left - 8, y + 3);
      }

      // Draw X-axis labels
      ctx.textAlign = "center";
      labels.forEach((lbl, idx) => {
        const x = getX(idx);
        ctx.fillStyle = idx >= 7 ? "#818cf8" : "rgba(148, 163, 184, 0.6)";
        ctx.font = idx >= 7 ? "bold 10px sans-serif" : "10px sans-serif";
        ctx.fillText(lbl, x, height - 12);
      });

      // Forecast Boundary Area (Confidence Interval Band)
      ctx.fillStyle = "rgba(99, 102, 241, 0.08)";
      ctx.beginPath();
      let started = false;
      for (let i = 6; i < labels.length; i++) {
        const x = getX(i);
        const upper = getY(forecast[i] * 1.12);
        if (!started) {
          ctx.moveTo(x, upper);
          started = true;
        } else {
          ctx.lineTo(x, upper);
        }
      }
      for (let i = labels.length - 1; i >= 6; i--) {
        const x = getX(i);
        const lower = getY(forecast[i] * 0.88);
        ctx.lineTo(x, lower);
      }
      ctx.closePath();
      ctx.fill();

      // Draw Actual Line
      ctx.strokeStyle = "#6366f1";
      ctx.lineWidth = 3;
      ctx.beginPath();
      for (let i = 0; i <= 6; i++) {
        const x = getX(i);
        const y = getY(actual[i]);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Draw Forecast Line (Dashed)
      ctx.strokeStyle = "#38bdf8";
      ctx.lineWidth = 2.5;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      for (let i = 6; i < labels.length; i++) {
        const x = getX(i);
        const y = getY(forecast[i]);
        if (i === 6) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.setLineDash([]); // Reset dash

      // Draw Points
      for (let i = 0; i <= 6; i++) {
        const x = getX(i);
        const y = getY(actual[i]);
        ctx.fillStyle = "#1e1b4b";
        ctx.beginPath();
        ctx.arc(x, y, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#818cf8";
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      for (let i = 7; i < labels.length; i++) {
        const x = getX(i);
        const y = getY(forecast[i]);
        ctx.fillStyle = "#0c4a6e";
        ctx.beginPath();
        ctx.arc(x, y, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#38bdf8";
        ctx.lineWidth = 2;
        ctx.stroke();
      }
    }

    function drawCategoryDonutChart() {
      const canvas = document.getElementById("categoryDonutChart");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");

      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);

      const width = rect.width;
      const height = rect.height;
      const centerX = width / 2;
      const centerY = height / 2;
      const radius = Math.min(centerX, centerY) - 15;
      const innerRadius = radius * 0.65;

      const slices = [
        { label: "Footwear", share: 0.40, color: "#6366f1" },
        { label: "Apparel", share: 0.29, color: "#38bdf8" },
        { label: "Electronics", share: 0.20, color: "#34d399" },
        { label: "Accessories", share: 0.11, color: "#fbbf24" }
      ];

      let startAngle = -Math.PI / 2;

      slices.forEach(slice => {
        const sliceAngle = slice.share * Math.PI * 2;
        ctx.fillStyle = slice.color;
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius, startAngle, startAngle + sliceAngle);
        ctx.arc(centerX, centerY, innerRadius, startAngle + sliceAngle, startAngle, true);
        ctx.closePath();
        ctx.fill();

        startAngle += sliceAngle;
      });

      // Center text
      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 16px sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText("$48.9k", centerX, centerY - 6);

      ctx.fillStyle = "rgba(148, 163, 184, 0.7)";
      ctx.font = "10px sans-serif";
      ctx.fillText("Total Sales", centerX, centerY + 12);
    }

    /* ================= COPILOT ENGINE ================= */
    function renderChatHistory() {
      const container = document.getElementById("copilotChatMessages");
      container.innerHTML = "";

      appState.chatHistory.forEach(msg => {
        const isUser = msg.role === "user";
        const wrapper = document.createElement("div");
        wrapper.className = `flex flex-col ${isUser ? 'items-end' : 'items-start'} space-y-1.5`;

        // Parse markdown bold **
        let formattedText = msg.text.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>');
        formattedText = formattedText.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded bg-slate-950 font-mono text-indigo-300 text-[11px]">$1</code>');

        wrapper.innerHTML = `
          <div class="flex items-center gap-1.5 text-[10px] text-slate-400 ${isUser ? 'justify-end' : ''}">
            <span>${isUser ? 'You' : '⚡ Retail Copilot'}</span>
            <span>&bull; ${msg.timestamp}</span>
          </div>
          <div class="max-w-[85%] rounded-2xl px-3.5 py-2.5 leading-relaxed ${isUser ? 'bg-indigo-600 text-white rounded-tr-sm' : 'bg-slate-950 border border-slate-800 text-slate-200 rounded-tl-sm'}">
            ${formattedText}
          </div>
        `;

        // Render Action DataCards if any
        if (msg.dataCards && msg.dataCards.length > 0) {
          msg.dataCards.forEach(card => {
            const cardEl = document.createElement("div");
            cardEl.className = "w-full max-w-[90%] bg-slate-900 border border-indigo-500/40 rounded-xl p-3 shadow-lg space-y-2 mt-1";
            cardEl.innerHTML = `
              <div class="font-semibold text-indigo-300 text-xs">${card.title}</div>
              <div class="text-slate-300 text-[11px]">${card.content}</div>
              ${card.action ? `
                <button onclick="handleCopilotAction('${card.prompt}')" class="mt-1 w-full bg-indigo-600 hover:bg-indigo-500 text-white py-1.5 px-3 rounded-lg text-xs font-semibold shadow transition active:scale-95 flex items-center justify-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  ${card.action}
                </button>
              ` : ''}
            `;
            wrapper.appendChild(cardEl);
          });
        }

        container.appendChild(wrapper);
      });

      container.scrollTop = container.scrollHeight;
    }

    function generateCopilotResponse(query) {
      const q = query.toLowerCase();

      // 1. Stockout Risk Query
      if (q.includes("stock out") || q.includes("risk") || q.includes("danger") || q.includes("critical") || q.includes("low stock")) {
        const criticalItems = appState.inventory.filter(i => computeMetrics(i).status === "Critical");
        const listText = criticalItems.map(i => `&bull; **${i.name}** (${i.stock} left &bull; ${computeMetrics(i).daysOfSupply} DOS &bull; Burn ${i.dailyVelocity}/d)`).join("<br>");

        return {
          text: `I analyzed your active SKU velocity. Currently **${criticalItems.length} SKUs** have breached the safety stock threshold:<br><br>${listText}<br><br>At this velocity, you will lose approximately **$6,480 in potential sales** over the next 14 days without reordering.`,
          dataCards: [
            {
              type: "action",
              title: "⚡ Recommended Action",
              content: "Auto-generate purchase orders for all 3 critical SKUs with Economic Order Quantity (EOQ) applied.",
              action: "Approve 3 Restock POs",
              prompt: "Draft restock purchase order for critical items"
            }
          ]
        };
      }

      // 2. Draft Restock PO Query
      if (q.includes("draft restock") || q.includes("reorder") || q.includes("purchase order") || q.includes("po")) {
        const needyItems = appState.inventory.filter(i => {
          const s = computeMetrics(i).status;
          return s === "Critical" || s === "Reorder";
        });

        const poItemsSummary = needyItems.map(i => {
          const suggested = Math.max(30, Math.round(i.dailyVelocity * 21)); // 21 days buffer
          return `&bull; **${i.name}**: +${suggested} units @ $${i.cost.toFixed(2)} ($${(suggested * i.cost).toFixed(0)})`;
        }).join("<br>");

        const totalOrderEst = needyItems.reduce((acc, i) => acc + (Math.max(30, Math.round(i.dailyVelocity * 21)) * i.cost), 0);

        return {
          text: `I drafted replenishment purchase orders for **${needyItems.length} items**:<br><br>${poItemsSummary}<br><br>Estimated Wholesale Cost: **$${totalOrderEst.toLocaleString()}**.<br>Average supplier turnaround: **4 - 6 days**.`,
          dataCards: [
            {
              type: "po",
              title: `🛒 Ready PO Draft ($${totalOrderEst.toLocaleString()})`,
              content: `Consolidated across AeroAthletics, Nordic Loom, and Apex Audio suppliers.`,
              action: "Review & Dispatch PO",
              prompt: "OPEN_PO_MODAL_MULTI"
            }
          ]
        };
      }

      // 3. Markdown / Slow-Moving Stagnant Stock Query
      if (q.includes("markdown") || q.includes("slow") || q.includes("stagnant") || q.includes("overstock") || q.includes("dead stock")) {
        const slowItems = appState.inventory.filter(i => computeMetrics(i).status === "Overstock");
        const listText = slowItems.map(i => `&bull; **${i.name}** (${i.stock} units, ${computeMetrics(i).daysOfSupply} DOS)`).join("<br>");

        return {
          text: `Found **${slowItems.length} stagnant SKUs** tying up capital:<br><br>${listText}<br><br>💡 **Copilot Recommendation**: Run a **20% Flash Promo** on *Polarized Carbon Sunglasses* and bundle *Graphene Parka* with thermal accessories. Expected to accelerate inventory turn by **3.4x** while preserving 38% gross margin.`,
          dataCards: [
            {
              type: "action",
              title: "🏷️ Markdown Simulator",
              content: "Apply 20% discount tag to SKU-4911 and SKU-8302 in catalog.",
              action: "Apply 20% Markdown",
              prompt: "APPLY_MARKDOWN_SIMULATION"
            }
          ]
        };
      }

      // 4. Forecast & Weekend Surge Query
      if (q.includes("forecast") || q.includes("weekend") || q.includes("surge") || q.includes("prediction") || q.includes("next week")) {
        return {
          text: `📈 **Weekend Forecast Intelligence**:<br><br>Projected Weekend Revenue: **$21,600** (+28% vs weekday baseline).<br><br>&bull; **Drivers**: Sunny weekend weather forecast driving outdoor apparel demand.<br>&bull; **High-Impact SKUs**: Trail Shorts (+35% lift), HydroFlask Tumblers (+40% lift).<br>&bull; **Operational Note**: Ensure 2 additional associates on floor during peak hours (2 PM - 6 PM Saturday).`,
          dataCards: [
            {
              type: "insight",
              title: "⛅ Weather Correlation Confidence: 92%",
              content: "Historical correlation between 72°F+ weekends and Footwear/Apparel sales is r=0.88.",
              action: "Simulate Weekend Traffic",
              prompt: "SIMULATE_WEEKEND_TRAFFIC"
            }
          ]
        };
      }

      // 5. Category Profitability Query
      if (q.includes("profit") || q.includes("margin") || q.includes("category")) {
        return {
          text: `📊 **Category Financial Breakdown**:<br><br>1. **Footwear**: $19,450 revenue &bull; 55.7% gross margin (Top Volume Driver)<br>2. **Apparel**: $14,200 revenue &bull; 62.4% gross margin (**Highest Margin Rate**)<br>3. **Electronics**: $9,720 revenue &bull; 48.0% gross margin<br>4. **Accessories**: $5,550 revenue &bull; 63.1% gross margin<br><br>Total blended gross margin: **56.8%**.`,
          dataCards: []
        };
      }

      // Default Retail Advisory
      return {
        text: `I've analyzed your query regarding *"${query}"* against your current inventory matrix of **${appState.inventory.length} SKUs** and **$48,920** weekly sales volume.<br><br>Key health takeaway: Inventory turnover is healthy (8.4x), but 3 high-velocity SKUs require immediate PO authorization to avoid estimated lost sales of $6,480.`,
        dataCards: [
          {
            type: "action",
            title: "Quick Action",
            content: "Check stockout projection or generate supplier restocks.",
            action: "Audit Stockout Risks",
            prompt: "Which products will stock out within 7 days?"
          }
        ]
      };
    }

    function handleChatSubmit(event) {
      if (event) event.preventDefault();
      const input = document.getElementById("copilotChatInput");
      const text = input.value.trim();
      if (!text) return;

      // Add user message
      appState.chatHistory.push({
        role: "user",
        timestamp: "Just now",
        text: text
      });
      input.value = "";
      renderChatHistory();

      // Show typing indicator
      const indicator = document.getElementById("copilotTypingIndicator");
      indicator.classList.remove("hidden");

      setTimeout(() => {
        indicator.classList.add("hidden");
        const reply = generateCopilotResponse(text);
        appState.chatHistory.push({
          role: "assistant",
          timestamp: "Just now",
          text: reply.text,
          dataCards: reply.dataCards
        });
        renderChatHistory();
      }, 650);
    }

    function handleCopilotQuickPrompt(promptText) {
      openCopilotDrawer();
      document.getElementById("copilotChatInput").value = promptText;
      handleChatSubmit();
    }

    function openCopilotWithPrompt(promptText) {
      openCopilotDrawer();
      document.getElementById("copilotChatInput").value = promptText;
      handleChatSubmit();
    }

    function handleCopilotAction(actionPrompt) {
      if (actionPrompt === "OPEN_PO_MODAL_MULTI") {
        openMultiItemPOModal();
      } else if (actionPrompt === "APPLY_MARKDOWN_SIMULATION") {
        // Mark down slow items
        appState.inventory.forEach(item => {
          if (computeMetrics(item).status === "Overstock") {
            item.price = +(item.price * 0.8).toFixed(2);
            item.dailyVelocity = +(item.dailyVelocity * 2.2).toFixed(1); // boost sales
          }
        });
        saveAndRefresh();
        showToast("🏷️ 20% Markdown applied to slow-moving inventory!");
        appState.chatHistory.push({
          role: "assistant",
          timestamp: "Just now",
          text: "✅ **Markdowns Applied Successfully!** Prices adjusted by -20%. Projected velocity has doubled, clearing excess stock within 21 days."
        });
        renderChatHistory();
      } else if (actionPrompt === "SIMULATE_WEEKEND_TRAFFIC") {
        simulateDaySales(true);
      } else {
        handleCopilotQuickPrompt(actionPrompt);
      }
    }

    function clearChatHistory() {
      appState.chatHistory = [
        {
          role: "assistant",
          timestamp: "Just now",
          text: "Chat cleared. What retail metrics or stock analysis would you like to explore?"
        }
      ];
      renderChatHistory();
    }

    /* ================= DRAWER & THEME CONTROLLERS ================= */
    function toggleCopilotDrawer() {
      const drawer = document.getElementById("copilotDrawer");
      drawer.classList.toggle("translate-x-full");
      document.getElementById("copilotBadge").classList.add("hidden");
    }
    function openCopilotDrawer() {
      const drawer = document.getElementById("copilotDrawer");
      drawer.classList.remove("translate-x-full");
      document.getElementById("copilotBadge").classList.add("hidden");
    }

    function toggleTheme() {
      const html = document.documentElement;
      const sun = document.getElementById("themeIconSun");
      const moon = document.getElementById("themeIconMoon");
      if (html.classList.contains("dark")) {
        html.classList.remove("dark");
        sun.classList.remove("hidden");
        moon.classList.add("hidden");
      } else {
        html.classList.add("dark");
        sun.classList.add("hidden");
        moon.classList.remove("hidden");
      }
      setTimeout(() => {
        drawSalesForecastChart();
        drawCategoryDonutChart();
      }, 50);
    }

    /* ================= FILTERS & ACTIONS ================= */
    function handleSearch(val) {
      appState.filters.search = val;
      renderInventoryTable();
    }
    function handleCategoryFilter(val) {
      appState.filters.category = val;
      renderInventoryTable();
    }
    function filterByStatus(status) {
      appState.filters.status = status;
      document.querySelectorAll(".status-tab-btn").forEach(btn => {
        if (btn.getAttribute("data-status") === status) {
          btn.className = "status-tab-btn px-3 py-1.5 rounded-lg font-medium bg-indigo-600/20 text-indigo-300 border border-indigo-500/40";
        } else {
          btn.className = "status-tab-btn px-3 py-1.5 rounded-lg font-medium text-slate-400 hover:text-white";
        }
      });
      renderInventoryTable();
    }

    function handleStoreChange(storeVal) {
      appState.filters.store = storeVal;
      showToast(`Switched view to: ${storeVal.toUpperCase()}`);
    }

    function setDateRange(range) {
      appState.filters.dateRange = range;
      document.querySelectorAll(".date-btn").forEach(btn => {
        if (btn.getAttribute("data-range") === range) {
          btn.className = "date-btn px-2.5 py-1 rounded bg-indigo-600 text-white font-medium";
        } else {
          btn.className = "date-btn px-2.5 py-1 rounded text-slate-400 hover:text-white";
        }
      });
      showToast(`Date range adjusted to: ${range.toUpperCase()}`);
    }

    /* ================= PURCHASE ORDER MODAL ================= */
    function triggerRestockSingle(sku) {
      const item = appState.inventory.find(i => i.sku === sku);
      if (!item) return;

      const suggestedQty = Math.max(30, Math.round(item.dailyVelocity * 20));
      const totalCost = (suggestedQty * item.cost).toFixed(2);

      appState.activeDraftPO = {
        supplier: item.supplier,
        items: [{ sku: item.sku, name: item.name, qty: suggestedQty, unitCost: item.cost }],
        totalCost: parseFloat(totalCost)
      };

      document.getElementById("poModalContent").innerHTML = `
        <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-2">
          <div class="flex justify-between font-medium">
            <span class="text-white">${item.name}</span>
            <span class="text-indigo-400">${item.sku}</span>
          </div>
          <div class="text-slate-400">Supplier: <strong class="text-slate-200">${item.supplier}</strong></div>
          <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800">
            <div>
              <label class="text-[11px] text-slate-400">Restock Quantity</label>
              <input type="number" id="poQtyInput" value="${suggestedQty}" min="10" oninput="updateSinglePOCost(${item.cost})" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-white font-bold">
            </div>
            <div>
              <label class="text-[11px] text-slate-400">Wholesale Unit Cost</label>
              <div class="text-slate-200 font-medium py-1.5">$${item.cost.toFixed(2)}</div>
            </div>
          </div>
          <div class="flex justify-between items-center pt-2 border-t border-slate-800 text-slate-300">
            <span>Total Wholesale Amount:</span>
            <span id="poTotalDisplay" class="font-bold text-emerald-400 text-sm">$${totalCost}</span>
          </div>
        </div>
      `;

      document.getElementById("poModal").classList.remove("hidden");
    }

    function updateSinglePOCost(unitCost) {
      const qty = parseInt(document.getElementById("poQtyInput").value) || 0;
      const total = (qty * unitCost).toFixed(2);
      document.getElementById("poTotalDisplay").textContent = `$${total}`;
      if (appState.activeDraftPO) {
        appState.activeDraftPO.items[0].qty = qty;
        appState.activeDraftPO.totalCost = parseFloat(total);
      }
    }

    function openMultiItemPOModal() {
      const needyItems = appState.inventory.filter(i => {
        const s = computeMetrics(i).status;
        return s === "Critical" || s === "Reorder";
      });

      const poItems = needyItems.map(i => {
        const qty = Math.max(30, Math.round(i.dailyVelocity * 20));
        return { sku: i.sku, name: i.name, qty, unitCost: i.cost, supplier: i.supplier };
      });

      const totalCost = poItems.reduce((acc, i) => acc + (i.qty * i.unitCost), 0);

      appState.activeDraftPO = {
        supplier: "Consolidated Suppliers (3)",
        items: poItems,
        totalCost: totalCost
      };

      const itemsHtml = poItems.map(i => `
        <div class="flex justify-between items-center py-1.5 border-b border-slate-800/60">
          <div>
            <div class="text-white font-medium">${i.name}</div>
            <div class="text-slate-500 text-[10px]">${i.sku} &bull; ${i.supplier}</div>
          </div>
          <div class="text-right">
            <span class="text-slate-200 font-bold">${i.qty} units</span>
            <div class="text-emerald-400 text-[11px]">$${(i.qty * i.unitCost).toLocaleString()}</div>
          </div>
        </div>
      `).join("");

      document.getElementById("poModalContent").innerHTML = `
        <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-2 max-h-60 overflow-y-auto">
          <div class="text-slate-400 text-[11px] font-semibold uppercase">Replenishment Order Items (${poItems.length})</div>
          ${itemsHtml}
          <div class="flex justify-between items-center pt-2 text-slate-200 font-semibold text-sm">
            <span>Total Wholesale Commitment:</span>
            <span class="text-emerald-400 font-bold">$${totalCost.toLocaleString()}</span>
          </div>
        </div>
      `;

      document.getElementById("poModal").classList.remove("hidden");
    }

    function openManualPOModal() {
      openMultiItemPOModal();
    }

    function closePOModal() {
      document.getElementById("poModal").classList.add("hidden");
      appState.activeDraftPO = null;
    }

    function confirmPurchaseOrder() {
      if (!appState.activeDraftPO) return;

      const newPO = {
        id: `PO-${Math.floor(1000 + Math.random() * 9000)}`,
        supplier: appState.activeDraftPO.supplier,
        itemCount: appState.activeDraftPO.items.reduce((acc, i) => acc + i.qty, 0),
        totalCost: appState.activeDraftPO.totalCost,
        status: "Dispatched",
        eta: "In 3 days",
        items: appState.activeDraftPO.items.map(i => `${i.name} (${i.qty})`).join(", ")
      };

      // Add to inventory incoming stock
      appState.activeDraftPO.items.forEach(poItem => {
        const inv = appState.inventory.find(i => i.sku === poItem.sku);
        if (inv) {
          inv.stock += poItem.qty; // Simulated arrival/dispatch
        }
      });

      appState.purchaseOrders.unshift(newPO);
      saveAndRefresh();
      closePOModal();
      showToast(`✅ Purchase Order ${newPO.id} successfully created & dispatched!`);

      // Copilot announcement
      appState.chatHistory.push({
        role: "assistant",
        timestamp: "Just now",
        text: `📦 **Purchase Order Confirmed:** \`${newPO.id}\` for **$${newPO.totalCost.toLocaleString()}** has been dispatched to suppliers. Stock counts adjusted.`
      });
      renderChatHistory();
    }

    /* ================= STOCK ADJUST MODAL ================= */
    let activeAdjustSKU = null;
    function openStockAdjustModal(sku) {
      const item = appState.inventory.find(i => i.sku === sku);
      if (!item) return;
      activeAdjustSKU = sku;

      const newQty = prompt(`Manual Inventory Adjustment for ${item.name} (${item.sku}):\nCurrent Stock: ${item.stock}`, item.stock);
      if (newQty !== null && !isNaN(parseInt(newQty))) {
        item.stock = Math.max(0, parseInt(newQty));
        saveAndRefresh();
        showToast(`Updated ${item.sku} stock to ${item.stock} units`);
      }
    }

    /* ================= ADD NEW SKU MODAL ================= */
    function openAddProductModal() {
      document.getElementById("skuModal").classList.remove("hidden");
    }
    function closeSkuModal() {
      document.getElementById("skuModal").classList.add("hidden");
    }
    function handleSkuFormSubmit(e) {
      e.preventDefault();
      const newSku = {
        sku: document.getElementById("formProdSKU").value.trim(),
        name: document.getElementById("formProdName").value.trim(),
        category: document.getElementById("formProdCat").value,
        price: parseFloat(document.getElementById("formProdPrice").value) || 49.99,
        cost: (parseFloat(document.getElementById("formProdPrice").value) * 0.45),
        stock: parseInt(document.getElementById("formProdStock").value) || 30,
        reorderPoint: parseInt(document.getElementById("formProdReorder").value) || 20,
        leadTimeDays: parseInt(document.getElementById("formProdLead").value) || 5,
        dailyVelocity: parseFloat(document.getElementById("formProdBurn").value) || 2.5,
        supplier: document.getElementById("formProdSupplier").value.trim() || "General Logistics",
        image: "📦"
      };

      appState.inventory.unshift(newSku);
      saveAndRefresh();
      closeSkuModal();
      showToast(`SKU ${newSku.sku} added to catalog`);
    }

    /* ================= SIMULATE SALES VELOCITY ================= */
    function simulateDaySales(isSurge = false) {
      let totalUnitsSold = 0;
      let totalRevenue = 0;

      appState.inventory.forEach(item => {
        const factor = isSurge ? (1.5 + Math.random() * 0.8) : (0.8 + Math.random() * 0.5);
        const unitsSold = Math.min(item.stock, Math.round(item.dailyVelocity * factor));
        if (unitsSold > 0) {
          item.stock -= unitsSold;
          totalUnitsSold += unitsSold;
          totalRevenue += (unitsSold * item.price);

          // Add transaction to live sales stream
          appState.salesStream.unshift({
            time: "Just now",
            item: item.name,
            qty: unitsSold,
            amount: `$${(unitsSold * item.price).toFixed(2)}`,
            channel: Math.random() > 0.5 ? "In-Store #104" : "Online Web"
          });
        }
      });

      if (appState.salesStream.length > 25) {
        appState.salesStream = appState.salesStream.slice(0, 25);
      }

      saveAndRefresh();
      showToast(`⚡ Simulation: ${totalUnitsSold} items sold! +$${totalRevenue.toLocaleString()} Revenue!`);
    }

    /* ================= EXPORT CSV ================= */
    function exportInventoryCSV() {
      let csvContent = "data:text/csv;charset=utf-8,";
      csvContent += "SKU,Product Name,Category,Price,Cost,Stock,Reorder Point,Lead Time (Days),Daily Velocity,Days of Supply,Status,Supplier\n";

      appState.inventory.forEach(item => {
        const m = computeMetrics(item);
        const row = [
          item.sku,
          `"${item.name.replace(/"/g, '""')}"`,
          item.category,
          item.price.toFixed(2),
          item.cost.toFixed(2),
          item.stock,
          item.reorderPoint,
          item.leadTimeDays,
          item.dailyVelocity,
          m.daysOfSupply,
          m.status,
          `"${item.supplier.replace(/"/g, '""')}"`
        ];
        csvContent += row.join(",") + "\n";
      });

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `retail_inventory_report_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("📥 Exported inventory report to CSV");
    }

    /* ================= TOAST NOTIFICATIONS ================= */
    function showToast(message) {
      const container = document.getElementById("toastContainer");
      const toast = document.createElement("div");
      toast.className = "pointer-events-auto bg-slate-900/95 border border-indigo-500/40 text-slate-100 text-xs px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 transform transition-all duration-300 translate-y-3 opacity-0";
      toast.innerHTML = `
        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
        <span>${message}</span>
      `;
      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove("translate-y-3", "opacity-0");
      }, 20);

      setTimeout(() => {
        toast.classList.add("translate-y-3", "opacity-0");
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    /* ================= STATE PERSISTENCE & INIT ================= */
    function saveAndRefresh() {
      localStorage.setItem("retail_inventory", JSON.stringify(appState.inventory));
      localStorage.setItem("retail_pos", JSON.stringify(appState.purchaseOrders));
      localStorage.setItem("retail_sales_stream", JSON.stringify(appState.salesStream));

      renderKPIs();
      renderInventoryTable();
      renderSalesStream();
      renderPurchaseOrders();
    }

    // Keyboard shortcut (Ctrl + /) to toggle Copilot
    window.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "/") {
        e.preventDefault();
        toggleCopilotDrawer();
      } else if (e.key === "Escape") {
        document.getElementById("copilotDrawer").classList.add("translate-x-full");
        closePOModal();
        closeSkuModal();
      }
    });

    // Window resize chart redraw
    window.addEventListener("resize", () => {
      drawSalesForecastChart();
      drawCategoryDonutChart();
    });

    // Initialize application on load
    window.addEventListener("DOMContentLoaded", () => {
      saveAndRefresh();
      renderChatHistory();
      setTimeout(() => {
        drawSalesForecastChart();
        drawCategoryDonutChart();
      }, 100);
    });
  </script>
</body>
</html>
