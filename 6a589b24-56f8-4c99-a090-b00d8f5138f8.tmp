<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Retail Pulse &bull; Sales & Inventory Copilot</title>
  <!-- Tailwind CSS -->
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <style>
    :root {
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    body {
      font-family: var(--font-sans);
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    /* Custom sleek scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(100, 116, 139, 0.08);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.35);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(148, 163, 184, 0.6);
    }

    /* Pulse animation */
    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }
    .animate-pulse-subtle {
      animation: pulse-subtle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    /* Glass effect */
    .glass-panel {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen antialiased flex flex-col selection:bg-indigo-500 selection:text-white">

  <!-- ================= TOP APP BAR ================= -->
  <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/80 glass-panel">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      
      <!-- Brand & Store Context -->
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-cyan-400 p-[1px] shadow-lg shadow-indigo-500/20">
          <div class="h-full w-full bg-slate-950 rounded-[11px] flex items-center justify-center">
            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">RetailPulse</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/30 font-medium">Copilot AI 2.4</span>
          </div>
          <p class="text-xs text-slate-400 hidden sm:block">Intelligent Sales &amp; Autonomous Inventory Optimization</p>
        </div>
      </div>

      <!-- Quick Store Selector & Filter Controls -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Store Selector -->
        <div class="relative">
          <select id="storeSelector" onchange="handleStoreChange(this.value)" class="bg-slate-900 border border-slate-800 text-slate-200 text-xs rounded-lg px-3 py-1.5 focus:outline-none focus:border-indigo-500 cursor-pointer pr-8 appearance-none font-medium">
            <option value="all">🏬 All Locations (Omnichannel)</option>
            <option value="downtown" selected>📍 Store #104 &bull; Downtown Flagship</option>
            <option value="metro">📍 Store #208 &bull; Metro Galleria</option>
            <option value="ecom">🌐 E-Commerce Fulfillment Hub</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </div>

        <!-- Date Range Filter -->
        <div class="hidden md:flex bg-slate-900 border border-slate-800 rounded-lg p-0.5 text-xs">
          <button onclick="setDateRange('today')" class="date-btn px-2.5 py-1 rounded text-slate-400 hover:text-white" data-range="today">Today</button>
          <button onclick="setDateRange('7d')" class="date-btn px-2.5 py-1 rounded bg-indigo-600 text-white font-medium" data-range="7d">7D</button>
          <button onclick="setDateRange('30d')" class="date-btn px-2.5 py-1 rounded text-slate-400 hover:text-white" data-range="30d">30D</button>
          <button onclick="setDateRange('qtd')" class="date-btn px-2.5 py-1 rounded text-slate-400 hover:text-white" data-range="qtd">QTD</button>
        </div>

        <!-- Simulate Sales Day Action -->
        <button onclick="simulateDaySales()" title="Simulate 1 day of retail velocity and purchase events" class="flex items-center gap-1.5 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/40 text-xs px-3 py-1.5 rounded-lg font-medium transition active:scale-95">
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="hidden sm:inline">Simulate Sales</span>
        </button>

        <!-- Toggle Copilot Panel (Mobile & Desktop) -->
        <button onclick="toggleCopilotDrawer()" class="relative flex items-center gap-1.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white text-xs px-3 py-1.5 rounded-lg font-medium shadow-md shadow-indigo-600/25 transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
          </svg>
          <span>Ask Copilot</span>
          <span id="copilotBadge" class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-rose-500 rounded-full ring-2 ring-slate-950"></span>
        </button>

        <!-- Light / Dark Theme Toggle -->
        <button onclick="toggleTheme()" id="themeBtn" class="p-1.5 rounded-lg border border-slate-800 bg-slate-900 text-slate-400 hover:text-white" title="Toggle Theme">
          <svg id="themeIconSun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg id="themeIconMoon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </div>

    </div>
  </header>

  <!-- ================= NOTIFICATION TOAST BAR ================= -->
  <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- ================= MAIN DASHBOARD CONTAINER ================= -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- COPILOT PROACTIVE INSIGHT BANNER -->
    <div id="copilotAlertBanner" class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-950/70 via-slate-900 to-indigo-950/70 border border-indigo-500/30 p-4 sm:p-5 shadow-xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-3">
          <div class="p-2 bg-indigo-500/20 border border-indigo-500/40 rounded-xl text-indigo-400 shrink-0">
            <svg class="w-6 h-6 animate-pulse-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-sm font-semibold text-white tracking-wide uppercase">Copilot Inventory Alert</h2>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/40">3 Critical Stockouts</span>
            </div>
            <p id="copilotInsightText" class="text-sm text-slate-300 mt-1">
              High velocity on <strong class="text-indigo-300">CloudStride Pro Shoes</strong> (14 left, burn rate 4.2/day). Projected stockout in <span class="text-rose-400 font-semibold">3.3 days</span>. Lead time is 5 days.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
          <button onclick="handleCopilotQuickPrompt('Draft restock purchase order for critical items')" class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold shadow-md transition active:scale-95 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            Auto-Draft Restock PO
          </button>
          <button onclick="openCopilotWithPrompt('Explain risk analysis for current low stock items')" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-medium border border-slate-700 transition">
            Deep Dive
          </button>
        </div>
      </div>
    </div>

    <!-- ================= EXECUTIVE KPI CARDS ================= -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Gross Sales Card -->
      <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 relative overflow-hidden group hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Gross Sales (7D)</span>
          <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <h3 id="kpiRevenue" class="text-2xl font-bold text-white">$48,920</h3>
          <span class="text-xs font-medium text-emerald-400 flex items-center">
            <svg class="w-3 h-3 inline mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
            +14.2%
          </span>
        </div>
        <div class="mt-3 flex items-center justify-between text-xs text-slate-400 border-t border-slate-800/80 pt-2.5">
          <span>Target: $45,000</span>
          <span class="text-emerald-400 font-medium">108.7% achieved</span>
        </div>
      </div>

      <!-- Inventory Health Index Card -->
      <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 relative overflow-hidden group hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Inventory Health Index</span>
          <div class="p-2 rounded-xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <h3 id="kpiHealthScore" class="text-2xl font-bold text-white">82<span class="text-base font-normal text-slate-400">/100</span></h3>
          <span class="text-xs font-medium text-amber-400 flex items-center">
            Needs attention
          </span>
        </div>
        <!-- Segmented health bar -->
        <div class="mt-3 w-full bg-slate-800 rounded-full h-2 flex overflow-hidden">
          <div id="barOptimal" class="bg-emerald-500 h-full" style="width: 68%" title="68% Optimal"></div>
          <div id="barLow" class="bg-amber-500 h-full" style="width: 18%" title="18% Low Stock"></div>
          <div id="barCritical" class="bg-rose-500 h-full" style="width: 9%" title="9% Critical"></div>
          <div id="barOverstock" class="bg-indigo-500 h-full" style="width: 5%" title="5% Overstock"></div>
        </div>
        <div class="mt-2 flex items-center justify-between text-[11px] text-slate-400">
          <span class="text-emerald-400">&bull; Optimal (68%)</span>
          <span class="text-rose-400">&bull; Critical (9%)</span>
        </div>
      </div>

      <!-- Stockout Risk at 14D Card -->
      <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 relative overflow-hidden group hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Revenue at Stockout Risk</span>
          <div class="p-2 rounded-xl bg-rose-500/10 text-rose-400 border border-rose-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <h3 id="kpiRiskCost" class="text-2xl font-bold text-rose-400">$6,480</h3>
          <span class="text-xs text-slate-400">next 14 days</span>
        </div>
        <div class="mt-3 flex items-center justify-between text-xs text-slate-400 border-t border-slate-800/80 pt-2.5">
          <span id="kpiCriticalCountText">3 SKUs below safety stock</span>
          <button onclick="filterByStatus('Critical')" class="text-indigo-400 hover:text-indigo-300 font-medium underline underline-offset-2">Filter items</button>
        </div>
      </div>

      <!-- Turn Rate & Days of Supply -->
      <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 relative overflow-hidden group hover:border-slate-700 transition shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Avg Days of Supply (DOS)</span>
          <div class="p-2 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          </div>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <h3 id="kpiDOS" class="text-2xl font-bold text-white">18.4 <span class="text-base font-normal text-slate-400">days</span></h3>
          <span class="text-xs font-medium text-emerald-400">Healthy velocity</span>
        </div>
        <div class="mt-3 flex items-center justify-between text-xs text-slate-400 border-t border-slate-800/80 pt-2.5">
          <span>Annual Turn: 8.4x</span>
          <span class="text-cyan-400 font-medium">Benchmark: 7.5x</span>
        </div>
      </div>

    </section>

    <!-- ================= VISUAL ANALYTICS SECTION ================= -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Chart 1: Sales Velocity vs Forecast (Canvas 2/3 width) -->
      <div class="lg:col-span-2 bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-semibold text-white text-base">Sales Revenue &amp; AI Demand Projection</h3>
              <span class="text-[10px] px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-mono">ARIMA + Neural Forecast</span>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">Historical 7 days actual vs. AI 7 days projected demand with 95% confidence interval</p>
          </div>
          <div class="flex items-center gap-4 text-xs">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
              <span class="text-slate-300">Actual ($)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-0.5 bg-cyan-400 border-b border-dashed border-cyan-300"></span>
              <span class="text-slate-300">AI Forecast</span>
            </div>
          </div>
        </div>

        <!-- Canvas Container -->
        <div class="relative w-full h-64 sm:h-72">
          <canvas id="salesForecastChart" class="w-full h-full block"></canvas>
          <div id="chartTooltip" class="hidden absolute pointer-events-none bg-slate-950/95 border border-slate-700 text-xs text-white p-2 rounded-lg shadow-xl z-20"></div>
        </div>

        <div class="mt-3 flex items-center justify-between text-xs text-slate-400 border-t border-slate-800/80 pt-3">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Predicted Weekend Surge: <strong>+28%</strong> (Footwear &amp; Apparel)</span>
          </div>
          <button onclick="handleCopilotQuickPrompt('Analyze forecast drivers for upcoming weekend')" class="text-indigo-400 hover:text-indigo-300 text-xs font-medium">Ask Copilot why &rarr;</button>
        </div>
      </div>

      <!-- Chart 2: Category Breakdown & Velocity Matrix -->
      <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-white text-base">Category Velocity</h3>
            <span class="text-xs text-slate-400">Revenue share</span>
          </div>
          <p class="text-xs text-slate-400 mb-4">Stock turnover vs gross margin contribution</p>
          
          <div class="relative w-full h-48 flex items-center justify-center">
            <canvas id="categoryDonutChart" class="w-full h-full max-h-48"></canvas>
          </div>
        </div>

        <!-- Category Legends -->
        <div class="space-y-2 mt-4 pt-3 border-t border-slate-800/80 text-xs">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
              <span class="text-slate-300">Footwear</span>
            </div>
            <span class="font-medium text-white">$19,450 (40%)</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
              <span class="text-slate-300">Apparel</span>
            </div>
            <span class="font-medium text-white">$14,200 (29%)</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <span class="text-slate-300">Electronics</span>
            </div>
            <span class="font-medium text-white">$9,720 (20%)</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
              <span class="text-slate-300">Accessories</span>
            </div>
            <span class="font-medium text-white">$5,550 (11%)</span>
          </div>
        </div>
      </div>

    </section>

    <!-- ================= INVENTORY HEALTH & REORDER TABLE ================= -->
    <section class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 shadow-sm space-y-4">
      
      <!-- Table Header & Controls -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-white text-base flex items-center gap-2">
            Inventory Health &amp; Stock Replenishment
            <span id="inventoryCountBadge" class="text-xs bg-slate-800 text-slate-300 px-2.5 py-0.5 rounded-full border border-slate-700">12 SKUs</span>
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">Real-time stock velocity, safety buffers, days of supply, and smart PO generation</p>
        </div>

        <!-- Filter tabs & Search -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Search input -->
          <div class="relative">
            <input type="text" id="searchInput" oninput="handleSearch(this.value)" placeholder="Search SKU, Product, Brand..." class="w-48 sm:w-60 bg-slate-950 border border-slate-800 text-xs rounded-lg pl-8 pr-3 py-1.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500">
            <svg class="w-3.5 h-3.5 text-slate-500 absolute left-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>

          <!-- Category filter -->
          <select id="categoryFilter" onchange="handleCategoryFilter(this.value)" class="bg-slate-950 border border-slate-800 text-xs rounded-lg px-2.5 py-1.5 text-slate-300 focus:outline-none focus:border-indigo-500">
            <option value="All">All Categories</option>
            <option value="Footwear">Footwear</option>
            <option value="Apparel">Apparel</option>
            <option value="Electronics">Electronics</option>
            <option value="Accessories">Accessories</option>
          </select>

          <!-- Export CSV button -->
          <button onclick="exportInventoryCSV()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-2.5 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5" title="Export Inventory to CSV">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            Export
          </button>

          <!-- Add Product Button -->
          <button onclick="openAddProductModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs px-3 py-1.5 rounded-lg font-medium transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Add SKU
          </button>
        </div>
      </div>

      <!-- Status Filter Tabs -->
      <div class="flex items-center gap-1 border-b border-slate-800/80 pb-2 text-xs overflow-x-auto">
        <button onclick="filterByStatus('All')" class="status-tab-btn px-3 py-1.5 rounded-lg font-medium bg-indigo-600/20 text-indigo-300 border border-indigo-500/40" data-status="All">All Items (<span id="countAll">12</span>)</button>
        <button onclick="filterByStatus('Critical')" class="status-tab-btn px-3 py-1.5 rounded-lg font-medium text-slate-400 hover:text-white" data-status="Critical">🚨 Critical Stockout (<span id="countCritical">3</span>)</button>
        <button onclick="filterByStatus('Reorder')" class="status-tab-btn px-3 py-1.5 rounded-lg font-medium text-slate-400 hover:text-white" data-status="Reorder">⚠️ Reorder Needed (<span id="countReorder">2</span>)</button>
        <button onclick="filterByStatus('Optimal')" class="status-tab-btn px-3 py-1.5 rounded-lg font-medium text-slate-400 hover:text-white" data-status="Optimal">✅ Optimal (<span id="countOptimal">5</span>)</button>
        <button onclick="filterByStatus('Overstock')" class="status-tab-btn px-3 py-1.5 rounded-lg font-medium text-slate-400 hover:text-white" data-status="Overstock">📦 Overstocked / Stagnant (<span id="countOverstock">2</span>)</button>
      </div>

      <!-- Inventory Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950/60 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
            <tr>
              <th class="py-3 px-3">Item &amp; SKU</th>
              <th class="py-3 px-3">Category</th>
              <th class="py-3 px-3">On Hand</th>
              <th class="py-3 px-3">Reorder Pt</th>
              <th class="py-3 px-3">Daily Burn</th>
              <th class="py-3 px-3">Days of Supply (DOS)</th>
              <th class="py-3 px-3">Status</th>
              <th class="py-3 px-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="inventoryTableBody" class="divide-y divide-slate-800/60">
            <!-- Populated via JavaScript -->
          </tbody>
        </table>
      </div>

    </section>

    <!-- ================= RECENT ACTIVITY & PURCHASE ORDERS ================= -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Recent Sales Activity Stream -->
      <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <h3 class="font-semibold text-white text-base">Live Sales Stream</h3>
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
          </div>
          <span class="text-xs text-slate-400">Updated in real-time</span>
        </div>
        <div id="salesStreamList" class="space-y-2.5 max-h-64 overflow-y-auto pr-1">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Purchase Orders & Restock Pipeline -->
      <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <h3 class="font-semibold text-white text-base">Restock &amp; Purchase Orders</h3>
            <span id="poCountBadge" class="text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full border border-indigo-500/30">2 In-Flight</span>
          </div>
          <button onclick="openManualPOModal()" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium">+ New PO</button>
        </div>
        <div id="poList" class="space-y-2.5 max-h-64 overflow-y-auto pr-1">
          <!-- Populated dynamically -->
        </div>
      </div>

    </section>

  </main>

  <!-- ================= COPILOT CHAT SIDE DRAWER / PANEL ================= -->
  <aside id="copilotDrawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-slate-900/95 backdrop-blur-xl border-l border-slate-800 shadow-2xl flex flex-col transform transition-transform duration-300 translate-x-full">
    
    <!-- Drawer Header -->
    <div class="p-4 border-b border-slate-800/80 flex items-center justify-between bg-slate-950/70">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-cyan-400 p-[1px]">
          <div class="w-full h-full bg-slate-950 rounded-[11px] flex items-center justify-center">
            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <h3 class="font-bold text-white text-sm">Retail Copilot AI</h3>
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          </div>
          <p class="text-[11px] text-slate-400">Grounded on real-time inventory &amp; sales data</p>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button onclick="clearChatHistory()" class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800" title="Clear Chat">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
        <button onclick="toggleCopilotDrawer()" class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800" title="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Suggested Quick Action Chips -->
    <div class="px-4 py-2.5 bg-slate-950/40 border-b border-slate-800/60 overflow-x-auto whitespace-nowrap space-x-1.5 text-[11px]">
      <button onclick="handleCopilotQuickPrompt('Which products will stock out within 7 days?')" class="inline-block px-2.5 py-1 rounded-full bg-slate-800 hover:bg-indigo-600/30 text-slate-300 hover:text-indigo-200 border border-slate-700/80 transition">
        🚨 7-day stockout risks
      </button>
      <button onclick="handleCopilotQuickPrompt('Draft restock purchase order for critical items')" class="inline-block px-2.5 py-1 rounded-full bg-slate-800 hover:bg-indigo-600/30 text-slate-300 hover:text-indigo-200 border border-slate-700/80 transition">
        📦 Draft Restock PO
      </button>
      <button onclick="handleCopilotQuickPrompt('Identify slow-moving stock & suggest markdown %')" class="inline-block px-2.5 py-1 rounded-full bg-slate-800 hover:bg-indigo-600/30 text-slate-300 hover:text-indigo-200 border border-slate-700/80 transition">
        🏷️ Markdown suggestions
      </button>
      <button onclick="handleCopilotQuickPrompt('What is our most profitable category this week?')" class="inline-block px-2.5 py-1 rounded-full bg-slate-800 hover:bg-indigo-600/30 text-slate-300 hover:text-indigo-200 border border-slate-700/80 transition">
        💰 Category profit breakdown
      </button>
    </div>

    <!-- Chat Message Stream -->
    <div id="copilotChatMessages" class="flex-1 p-4 overflow-y-auto space-y-4 text-xs">
      <!-- Welcome message populated in JS -->
    </div>

    <!-- Typing indicator -->
    <div id="copilotTypingIndicator" class="hidden px-4 py-2 text-xs text-indigo-400 flex items-center gap-2 bg-slate-950/40">
      <span class="flex gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-bounce"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-bounce" style="animation-delay: 0.15s"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-bounce" style="animation-delay: 0.3s"></span>
      </span>
      <span>Copilot is analyzing SKU inventory &amp; demand models...</span>
    </div>

    <!-- Chat Input Form -->
    <div class="p-3 border-t border-slate-800/80 bg-slate-950/80">
      <form onsubmit="handleChatSubmit(event)" class="flex items-center gap-2">
        <input type="text" id="copilotChatInput" placeholder="Ask anything: 'Restock shoes', 'Show margin', 'DOS forecast'..." class="flex-1 bg-slate-900 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white p-2.5 rounded-xl transition shadow-md shadow-indigo-600/30 active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </form>
      <div class="mt-2 text-[10px] text-slate-500 flex items-center justify-between">
        <span>Powered by grounded heuristic AI algorithms</span>
        <span>Esc to close</span>
      </div>
    </div>

  </aside>

  <!-- ================= PURCHASE ORDER / RESTOCK MODAL ================= -->
  <div id="poModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <div class="p-2 bg-indigo-500/20 text-indigo-400 rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-white">Generate Purchase Order</h3>
            <p class="text-xs text-slate-400">Automated supplier reorder draft</p>
          </div>
        </div>
        <button onclick="closePOModal()" class="text-slate-400 hover:text-white">&times;</button>
      </div>

      <div id="poModalContent" class="space-y-3 text-xs">
        <!-- Injected via script -->
      </div>

      <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800">
        <button onclick="closePOModal()" class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs">Cancel</button>
        <button id="confirmPOBtn" onclick="confirmPurchaseOrder()" class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs shadow-lg shadow-indigo-600/30">
          Approve &amp; Dispatch PO
        </button>
      </div>
    </div>
  </div>

  <!-- ================= ADD / EDIT SKU MODAL ================= -->
  <div id="skuModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-white" id="skuModalTitle">Add New Product SKU</h3>
        <button onclick="closeSkuModal()" class="text-slate-400 hover:text-white">&times;</button>
      </div>

      <form onsubmit="handleSkuFormSubmit(event)" class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">Product Name</label>
          <input type="text" id="formProdName" required placeholder="e.g. Ultra-Light Running Jacket" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">SKU Code</label>
            <input type="text" id="formProdSKU" required placeholder="e.g. SKU-8841" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Category</label>
            <select id="formProdCat" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
              <option value="Footwear">Footwear</option>
              <option value="Apparel">Apparel</option>
              <option value="Electronics">Electronics</option>
              <option value="Accessories">Accessories</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">On Hand</label>
            <input type="number" id="formProdStock" required min="0" value="50" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Reorder Pt</label>
            <input type="number" id="formProdReorder" required min="1" value="25" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Burn/Day</label>
            <input type="number" step="0.1" id="formProdBurn" required min="0.1" value="3.5" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">Retail Price ($)</label>
            <input type="number" step="0.01" id="formProdPrice" required min="1" value="89.99" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Lead Time (Days)</label>
            <input type="number" id="formProdLead" required min="1" value="5" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
          </div>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Primary Supplier</label>
          <input type="text" id="formProdSupplier" required value="Vanguard Supplies Ltd" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-slate-200">
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800">
          <button type="button" onclick="closeSkuModal()" class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 text-xs">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs">Save SKU</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= FOOTER ================= -->
  <footer class="border-t border-slate-800/80 py-4 bg-slate-950 text-slate-500 text-xs text-center">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Retail Copilot Engine v2.4 Active &bull; Connected to Local Store Node</span>
      </div>
      <div>
        <span>Keyboard Shortcut: Press <kbd class="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300">Ctrl + /</kbd> to summon Copilot</span>
      </div>
    </div>
  </footer>

